# CDN-EP (MyLearningSphere) environment variables. NAMES ONLY: never put real
# values in this file. Copy it to .env.local for local work (.env.local is
# gitignored) and set the same names on Vercel (Production and Preview).
#
# Every value comes from the CDN-EP Supabase project, never the survey app's.

# Postgres connection the app uses at runtime (src/lib/prisma.ts).
# Supabase > Connect > Transaction pooler (port 6543) is fine for Vercel.
DATABASE_URL=

# Session connection for `prisma migrate` (prisma.config.ts).
# Supabase > Connect > Direct connection or Session pooler (port 5432).
# Not needed on Vercel.
DIRECT_URL=

# Supabase > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Lets an ADMIN create a sign-in account together with a profile.
# Optional: without it, admins can only link accounts that already exist.
SUPABASE_SERVICE_ROLE_KEY=

# REQUIRED, server-only, at least 32 characters. Keys the Form 1.3 author hash.
# Use the SAME value as the existing production deployment, and never rotate
# it: a different key breaks the Form 1.3 duplicate check and the start-date
# lock for every existing row. Without it, Form 1.3 is unavailable.
NUTRITION_AUTHOR_HASH_KEY=

# Comma-separated emails of super admins. A signed-in account whose CONFIRMED
# email is listed counts as nutrition ADMIN (with or without a profile) and
# also sees the month's attendance void list on /nutrition/admin/attendance.
# A super admin can never file or read an individual Form 1.3. This is how the
# first admin gets in on an empty database. Empty or unset = no super admin.
NUTRITION_SUPER_ADMIN_EMAILS=
